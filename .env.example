# Đặt biến trong shell; file này chỉ là mẫu, Python không tự đọc .env.
export PROVIDER=openai
export MODEL=YOUR_TOOL_CALLING_MODEL
export OPENAI_API_KEY=YOUR_KEY
# export GEMINI_API_KEY=YOUR_KEY
# export ANTHROPIC_API_KEY=YOUR_KEY
# export OPENROUTER_API_KEY=YOUR_KEY
# Groq: đặt PROVIDER=groq và MODEL=openai/gpt-oss-20b.
# export GROQ_API_KEY=YOUR_KEY
# NVIDIA NIM: PROVIDER=nvidia, MODEL=nvidia/nemotron-3.5-lightning-30b-a3b.
# export NVIDIA_API_KEY=YOUR_KEY
# DeepSeek: PROVIDER=deepseek, MODEL=deepseek-flash.
# export DEEPSEEK_API_KEY=YOUR_KEY
